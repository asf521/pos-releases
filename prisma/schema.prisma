// سيرفر التراخيص المستقل — قاعدة بيانات منفصلة تمامًا عن أي عيادة عميل.
// كل عميل (عيادة) هو صف "License" هنا، بغض النظر عن نظامه الداخلي.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LicenseType {
  trial
  premium
  /// دائم: مفيش تاريخ انتهاء، بيفضل شغال لحد ما إنت تلغيه (POS بس)
  full
}

enum LicenseStatus {
  active
  revoked
  expired
}

enum LicenseActivationStatus {
  pending
  approved
  revoked
}

model License {
  id String @id @default(uuid()) @db.Uuid

  /// المنتج اللي الترخيص ده بتاعه: 'clinic' (سنا سنتر — العيادات) أو 'pos' (SanaSoftware POS).
  /// كل منتج له مفتاح توقيع خاص ومسار خاص (/ و /pos) عشان مايتلخبطوش.
  product String @default("clinic")

  clientId   String  @unique @map("client_id") // مُعرّف فريد للعميل/العيادة، مثال: sana-center-001
  clientName String? @map("client_name")
  contactPhone String? @map("contact_phone")
  contactNote  String? @map("contact_note")

  type   LicenseType
  status LicenseStatus @default(active)

  activationKey String @unique @map("activation_key")

  maxDevices Int      @default(1) @map("max_devices")
  features   String[] @default([])

  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  notes String?

  activations LicenseActivation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([product])
  @@map("licenses")
}

model LicenseActivation {
  id String @id @default(uuid()) @db.Uuid

  licenseId String  @map("license_id") @db.Uuid
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  hardwareId String  @map("hardware_id")
  deviceName String? @map("device_name")

  /// كود قصير مقروء (مثال: 7K4P-QW2X) بيظهر للعميل يقوله للمُورِّد تليفونيًا
  /// عشان يوافق على الجهاز — بديل عن قراءة الـ hardwareId الخام الطويل
  deviceCode String @unique @map("device_code")

  status LicenseActivationStatus @default(pending)

  activatedAt    DateTime  @default(now()) @map("activated_at")
  approvedAt     DateTime? @map("approved_at")
  lastVerifiedAt DateTime  @default(now()) @map("last_verified_at")
  revokedAt      DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([licenseId, hardwareId])
  @@map("license_activations")
}

/// إصدارات تحديث تطبيق سطح المكتب (Tauri) — ملفات التثبيت نفسها مستضافة
/// مجانًا على GitHub Releases، والصف ده بس بيخزّن الـ manifest (رقم
/// الإصدار، التوقيع، رابط التحميل) + مفتاح تفعيل/تعطيل فوري (enabled)
/// لو ظهرت مشكلة في إصدار بعد نشره ولازم نوقفه فورًا من غير ما ننزّل
/// إصدار تاني. "target" مستقبلاً ممكن يبقى 'backend' كمان لنفس الفكرة.
model AppRelease {
  id String @id @default(uuid()) @db.Uuid

  target  String @default("frontend") // 'frontend' حاليًا، قابل للتوسعة لـ 'backend'
  version String

  notes String?

  /// { "windows-x86_64": { "signature": "...", "url": "https://github.com/..." } }
  platforms Json

  enabled Boolean @default(true)

  pubDate   DateTime @default(now()) @map("pub_date")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([target, version])
  @@index([target, enabled])
  @@map("app_releases")
}
